# =====================================================
# VARIABLES DE ENTORNO - TEMPLATE
# =====================================================
# Copia este archivo como .env.local y llena con tus credenciales REALES
# Ver ENV_SETUP.md para instrucciones completas

# ============================================
# ENCRYPTION KEY (genera con: openssl rand -base64 32)
# ============================================
ENCRYPTION_KEY=your_32_byte_encryption_key_here

# ============================================
# PROVEEDORES DE IA
# ============================================
# Proveedor activo (gemini | deepseek)
AI_PROVIDER=deepseek

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# ============================================
# SUPABASE CONFIGURATION (Frontend - anon key)
# ============================================
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key

# Variables para Angular (deben empezar con NG_APP_)
NG_APP_SUPABASE_URL=your_supabase_project_url
NG_APP_SUPABASE_ANON_KEY=your_supabase_anon_key

# ============================================
# SUPABASE ADMIN (Backend - service_role key)
# ============================================
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# ============================================
# FEATURE FLAGS
# ============================================
USE_DATABASE=true

# ============================================
# SERENITY REPORT - GitHub Actions (fallback global para todos los usuarios)
# Estos valores se usan cuando el usuario no tiene config propia en Supabase.
# ============================================
GH_DISPATCH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GH_DISPATCH_OWNER=anbepa
GH_DISPATCH_REPO=ManualTest
GH_DISPATCH_WORKFLOW_ID=serenity-report.yml
GH_DISPATCH_BRANCH=main
GH_DISPATCH_GITHUB_USERNAME=anbepa
GH_DISPATCH_WORKFLOW_NAME=Serenity Report
GH_DISPATCH_REPOSITORY_URL=https://github.com/anbepa/ManualTest
