{
  "version": 2,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist/test-plan-app/browser",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60,
      "memory": 1024,
      "excludeFiles": "api/**/{shared.ts,types.d.ts,middleware.config.ts}"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1",
      "headers": {
        "Cache-Control": "no-store, max-age=0"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
